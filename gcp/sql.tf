# Counterpart of the Postgres the API uses on AWS (an ECS sidecar, see CLAUDE.md).
# Cloud SQL does not pause on idle: it bills per hour until db_activation_policy = "NEVER".
resource "google_sql_database_instance" "main" {
  name             = "spry-pg"
  database_version = "POSTGRES_16" # the same major version as the sidecar (postgres:16.4)
  region           = var.region

  deletion_protection = var.db_deletion_protection

  settings {
    # Shared-core tiers exist only in the Enterprise edition; PG16 would default to Enterprise Plus.
    edition           = "ENTERPRISE"
    tier              = var.db_tier
    activation_policy = var.db_activation_policy
    availability_type = "ZONAL"
    disk_type         = "PD_SSD"
    disk_size         = 10
    disk_autoresize   = false

    # The data is test data, recreated by migrations; backups would add storage cost.
    backup_configuration {
      enabled = false
    }

    # Public IP but no authorised networks: the only way in is the Cloud SQL connector
    # (IAM-checked), which Cloud Run attaches as a Unix socket. No VPC, no NAT, no connector.
    ip_configuration {
      ipv4_enabled = true
      ssl_mode     = "ENCRYPTED_ONLY"
    }

    user_labels = {
      project    = "spry"
      managed-by = "terraform"
    }
  }

  depends_on = [google_project_service.enabled]
}

resource "google_sql_database" "spry" {
  name     = "spry"
  instance = google_sql_database_instance.main.name
}

# Generated by Terraform, stored in Secret Manager, never in the repository.
# It is in the state too (as with infra/): the state lives in HCP Terraform.
resource "random_password" "db" {
  length  = 32
  special = false # it goes into a URL
}

resource "google_sql_user" "app" {
  name     = "spry"
  instance = google_sql_database_instance.main.name
  password = random_password.db.result
}
