# Copy to terraform.tfvars when a GCP project exists. No secrets belong here:
# the DB password is generated by Terraform and lives in Secret Manager.
project_id = "spry-katttern-2026"
region     = "us-central1"

backend_image_tag = "latest"

# "NEVER" stops Cloud SQL between demos; only its 10 GB SSD ($1.70/month) is billed.
db_activation_policy = "ALWAYS"

# gh api repos/katttern/Peach --jq '.id, .owner.id'
github_repository_id       = ""
github_repository_owner_id = ""
