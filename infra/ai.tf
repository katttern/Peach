# Former stack peach-ai (infra/ai.yml, Lab 6): agenda parser Lambda behind a
# public Function URL (the Cognito JWT is checked in the handler), plus the
# monthly cost budget.

resource "aws_iam_role" "parser" {
  # Generated by CloudFormation; ForceNew, so it stays as deployed.
  name               = "peach-ai-ParserRole-XbH92tsbFUwc"
  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
}

resource "aws_iam_role_policy" "parser" {
  name = "parser"
  role = aws_iam_role.parser.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      # Messages API on bedrock-mantle, not bedrock:InvokeModel.
      {
        Effect   = "Allow"
        Action   = "bedrock-mantle:CreateInference"
        Resource = "*"
      },
      # Converse for Amazon Nova. The us.* inference profile routes to several
      # US regions, so the foundation model is allowed in any.
      {
        Effect = "Allow"
        Action = "bedrock:InvokeModel"
        Resource = [
          "arn:aws:bedrock:*::foundation-model/amazon.nova-*",
          "arn:aws:bedrock:${var.region}:${data.aws_caller_identity.current.account_id}:inference-profile/us.amazon.nova-*",
        ]
      },
    ]
  })
}

resource "aws_iam_role_policy_attachment" "parser_basic" {
  role       = aws_iam_role.parser.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_cloudwatch_log_group" "parser" {
  name              = "/aws/lambda/${var.project_name}-agenda-parser"
  retention_in_days = 14
}

resource "aws_lambda_function" "parser" {
  function_name = "${var.project_name}-agenda-parser"
  package_type  = "Image"
  image_uri     = var.parser_image_uri
  architectures = ["x86_64"]
  role          = aws_iam_role.parser.arn
  timeout       = 30
  memory_size   = 512

  image_config {
    command = ["app.ai.agenda_lambda.handler"]
  }

  environment {
    variables = {
      PARSER_MODEL = var.parser_model
      # Were stack parameters copied from peach-auth outputs; now references.
      COGNITO_AUTHORITY = "https://${aws_cognito_user_pool.main.endpoint}"
      COGNITO_CLIENT_ID = aws_cognito_user_pool_client.web.id
    }
  }

  logging_config {
    log_format = "Text"
    log_group  = aws_cloudwatch_log_group.parser.name
  }
}

resource "aws_lambda_function_url" "parser" {
  function_name      = aws_lambda_function.parser.function_name
  authorization_type = "NONE"

  cors {
    allow_origins = var.allowed_origins
    allow_methods = ["POST"]
    allow_headers = ["authorization", "content-type"]
    max_age       = 300
  }
}

resource "aws_lambda_permission" "parser_url" {
  # Statements left in place by the deleted CFN stack (Retain); imported.
  statement_id           = "peach-ai-ParserUrlPermission-QdTCW31eNsNe"
  action                 = "lambda:InvokeFunctionUrl"
  function_name          = aws_lambda_function.parser.function_name
  principal              = "*"
  function_url_auth_type = "NONE"
}

resource "aws_lambda_permission" "parser_invoke_via_url" {
  statement_id             = "peach-ai-ParserInvokePermission-89xH9X8Em6MK"
  action                   = "lambda:InvokeFunction"
  function_name            = aws_lambda_function.parser.function_name
  principal                = "*"
  invoked_via_function_url = true
}

# ---------- cost guard ----------
# Account-wide: PROJECT_NAME is not activated as a cost allocation tag.
resource "aws_budgets_budget" "monthly" {
  name         = "${var.project_name}-monthly"
  budget_type  = "COST"
  time_unit    = "MONTHLY"
  limit_amount = "5.0"
  limit_unit   = "USD"

  notification {
    notification_type          = "ACTUAL"
    comparison_operator        = "GREATER_THAN"
    threshold                  = 80
    threshold_type             = "PERCENTAGE"
    subscriber_email_addresses = [var.alert_email]
  }

  notification {
    notification_type          = "FORECASTED"
    comparison_operator        = "GREATER_THAN"
    threshold                  = 100
    threshold_type             = "PERCENTAGE"
    subscriber_email_addresses = [var.alert_email]
  }
}
